<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET"/>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.Na_Navalha">

        <activity
            android:name=".LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".HomeActivity" android:exported="false"/>
        <activity android:name=".MainActivity" android:exported="false"/>
        <activity android:name=".ServicosActivity" android:exported="false"/>
        <activity android:name=".HorariosActivity" android:exported="false"/>
        <activity android:name=".BarbeirosActivity" android:exported="false"/>
        <activity android:name=".PerfilActivity" android:exported="false"/>
        <activity android:name=".AgendamentoFluxoActivity" android:exported="false"/>
        <activity android:name=".NotificacoesActivity" android:exported="false"/>
        <activity android:name=".AjudaActivity" android:exported="false"/>
        <activity android:name=".DadosPessoaisActivity" android:exported="false"/>

    </application>
</manifest>