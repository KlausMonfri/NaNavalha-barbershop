<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#111111">

        <!-- HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1a1a1a"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/btnVoltar"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:text="&#8592;"
                android:textColor="#F5F5F0"
                android:textSize="20sp"
                android:gravity="center"
                android:background="#2A2A2A"
                android:layout_marginEnd="12dp"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ajuda e FAQ"
                    android:textColor="#F5F5F0"
                    android:textSize="20sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Perguntas frequentes"
                    android:textColor="#888888"
                    android:textSize="12sp"/>

            </LinearLayout>

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="#C8102E"/>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- BUSCA -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="#1E1E1E"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:layout_marginBottom="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Buscar..."
                        android:textColor="#555555"
                        android:textSize="14sp"/>

                </LinearLayout>

                <!-- CATEGORIA AGENDAMENTOS -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AGENDAMENTOS"
                    android:textColor="#C8102E"
                    android:textSize="11sp"
                    android:letterSpacing="0.2"
                    android:layout_marginBottom="8dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#1E1E1E"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:id="@+id/faq1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Como fazer um agendamento?"
                                android:textColor="#F5F5F0"
                                android:textSize="14sp"/>

                            <TextView
                                android:id="@+id/seta1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="+"
                                android:textColor="#C8102E"
                                android:textSize="20sp"/>

                        </LinearLayout>

                        <TextView
                            android:id="@+id/resp1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Para fazer um agendamento, clique em Servicos na barra de navegacao, escolha o servico desejado, selecione o barbeiro, data e horario e confirme!"
                            android:textColor="#888888"
                            android:textSize="13sp"
                            android:layout_marginTop="8dp"
                            android:visibility="gone"/>

                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#2A2A2A"/>

                    <LinearLayout
                        android:id="@+id/faq2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Como cancelar um agendamento?"
                                android:textColor="#F5F5F0"
                                android:textSize="14sp"/>

                            <TextView
                                android:id="@+id/seta2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="+"
                                android:textColor="#C8102E"
                                android:textSize="20sp"/>

                        </LinearLayout>

                        <TextView
                            android:id="@+id/resp2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Para cancelar, va em Horarios, encontre o agendamento desejado e clique em Cancelar. Cancelamentos sem custo ate 2h antes do horario."
                            android:textColor="#888888"
                            android:textSize="13sp"
                            android:layout_marginTop="8dp"
                            android:visibility="gone"/>

                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#2A2A2A"/>

                    <LinearLayout
                        android:id="@+id/faq3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Posso remarcar meu horario?"
                                android:textColor="#F5F5F0"
                                android:textSize="14sp"/>

                            <TextView
                                android:id="@+id/seta3"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="+"
                                android:textColor="#C8102E"
                                android:textSize="20sp"/>

                        </LinearLayout>

                        <TextView
                            android:id="@+id/resp3"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Sim! Va em Horarios, encontre o agendamento e clique em Remarcar para escolher uma nova data e horario."
                            android:textColor="#888888"
                            android:textSize="13sp"
                            android:layout_marginTop="8dp"
                            android:visibility="gone"/>

                    </LinearLayout>

                </LinearLayout>

                <!-- CATEGORIA PAGAMENTOS -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PAGAMENTOS"
                    android:textColor="#C8102E"
                    android:textSize="11sp"
                    android:letterSpacing="0.2"
                    android:layout_marginBottom="8dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#1E1E1E"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:id="@+id/faq4"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Quais formas de pagamento sao aceitas?"
                                android:textColor="#F5F5F0"
                                android:textSize="14sp"/>

                            <TextView
                                android:id="@+id/seta4"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="+"
                                android:textColor="#C8102E"
                                android:textSize="20sp"/>

                        </LinearLayout>

                        <TextView
                            android:id="@+id/resp4"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Aceitamos dinheiro, cartao de debito, credito e PIX diretamente na barbearia."
                            android:textColor="#888888"
                            android:textSize="13sp"
                            android:layout_marginTop="8dp"
                            android:visibility="gone"/>

                    </LinearLayout>

                </LinearLayout>

                <!-- CATEGORIA CONTA -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CONTA"
                    android:textColor="#C8102E"
                    android:textSize="11sp"
                    android:letterSpacing="0.2"
                    android:layout_marginBottom="8dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#1E1E1E"
                    android:layout_marginBottom="24dp">

                    <LinearLayout
                        android:id="@+id/faq5"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Como alterar minha senha?"
                                android:textColor="#F5F5F0"
                                android:textSize="14sp"/>

                            <TextView
                                android:id="@+id/seta5"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="+"
                                android:textColor="#C8102E"
                                android:textSize="20sp"/>

                        </LinearLayout>

                        <TextView
                            android:id="@+id/resp5"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Va em Perfil, clique em Dados pessoais e selecione Alterar senha. Voce recebera um email com as instrucoes."
                            android:textColor="#888888"
                            android:textSize="13sp"
                            android:layout_marginTop="8dp"
                            android:visibility="gone"/>

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>
        </ScrollView>

    </LinearLayout>
</layout>