<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#111111">

        <!-- HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1a1a1a"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/btnVoltar"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:text="&#8592;"
                android:textColor="#F5F5F0"
                android:textSize="20sp"
                android:gravity="center"
                android:background="#2A2A2A"
                android:layout_marginEnd="12dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dados Pessoais"
                android:textColor="#F5F5F0"
                android:textSize="20sp"
                android:textStyle="bold"/>

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="#C8102E"/>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- AVATAR -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="24dp">

                    <TextView
                        android:id="@+id/tvAvatarDados"
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:text="C"
                        android:textColor="#F5F5F0"
                        android:textSize="32sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:background="#C8102E"
                        android:layout_marginBottom="12dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Alterar foto"
                        android:textColor="#C8102E"
                        android:textSize="13sp"/>

                </LinearLayout>

                <!-- CAMPOS -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="INFORMACOES PESSOAIS"
                    android:textColor="#555555"
                    android:textSize="11sp"
                    android:letterSpacing="0.2"
                    android:layout_marginBottom="8dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#1E1E1E"
                    android:layout_marginBottom="16dp">

                    <!-- NOME -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Nome completo"
                            android:textColor="#888888"
                            android:textSize="11sp"
                            android:layout_marginBottom="4dp"/>

                        <android.widget.EditText
                            android:id="@+id/etNomeDados"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Cliente"
                            android:textColor="#F5F5F0"
                            android:textSize="15sp"
                            android:background="@null"
                            android:enabled="false"/>

                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#2A2A2A"/>

                    <!-- EMAIL -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="E-mail"
                            android:textColor="#888888"
                            android:textSize="11sp"
                            android:layout_marginBottom="4dp"/>

                        <android.widget.EditText
                            android:id="@+id/etEmailDados"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="cliente@email.com"
                            android:textColor="#F5F5F0"
                            android:textSize="15sp"
                            android:background="@null"
                            android:enabled="false"/>

                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#2A2A2A"/>

                    <!-- TELEFONE -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Telefone"
                            android:textColor="#888888"
                            android:textSize="11sp"
                            android:layout_marginBottom="4dp"/>

                        <android.widget.EditText
                            android:id="@+id/etTelefoneDados"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Nao informado"
                            android:textColor="#F5F5F0"
                            android:textColorHint="#555555"
                            android:textSize="15sp"
                            android:background="@null"
                            android:enabled="false"/>

                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#2A2A2A"/>

                    <!-- CPF -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="CPF"
                            android:textColor="#888888"
                            android:textSize="11sp"
                            android:layout_marginBottom="4dp"/>

                        <android.widget.EditText
                            android:id="@+id/etCpfDados"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Nao informado"
                            android:textColor="#F5F5F0"
                            android:textColorHint="#555555"
                            android:textSize="15sp"
                            android:background="@null"
                            android:enabled="false"/>

                    </LinearLayout>

                </LinearLayout>

                <!-- SEGURANÇA -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SEGURANCA"
                    android:textColor="#555555"
                    android:textSize="11sp"
                    android:letterSpacing="0.2"
                    android:layout_marginBottom="8dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#1E1E1E"
                    android:layout_marginBottom="24dp">

                    <LinearLayout
                        android:id="@+id/btnAlterarSenha"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Alterar senha"
                            android:textColor="#F5F5F0"
                            android:textSize="14sp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=">"
                            android:textColor="#555555"
                            android:textSize="16sp"/>

                    </LinearLayout>

                </LinearLayout>

                <!-- BOTÃO EDITAR -->
                <Button
                    android:id="@+id/btnEditar"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="Editar informacoes"
                    android:textColor="#F5F5F0"
                    android:backgroundTint="#C8102E"
                    android:stateListAnimator="@null"
                    android:layout_marginBottom="16dp"/>

            </LinearLayout>
        </ScrollView>

    </LinearLayout>
</layout>