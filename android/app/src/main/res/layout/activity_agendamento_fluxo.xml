<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#111111">

        <!-- HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1a1a1a"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/btnVoltar"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:text="&#8592;"
                    android:textColor="#F5F5F0"
                    android:textSize="20sp"
                    android:gravity="center"
                    android:background="#2A2A2A"
                    android:layout_marginEnd="12dp"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Novo Agendamento"
                        android:textColor="#F5F5F0"
                        android:textSize="18sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/tvPasso"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Passo 1 de 5"
                        android:textColor="#888888"
                        android:textSize="12sp"/>

                </LinearLayout>

            </LinearLayout>

            <!-- PROGRESS BAR -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tab1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Servico"
                    android:textColor="#C8102E"
                    android:textSize="10sp"
                    android:gravity="center"/>

                <TextView
                    android:id="@+id/tab2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Barbeiro"
                    android:textColor="#555555"
                    android:textSize="10sp"
                    android:gravity="center"/>

                <TextView
                    android:id="@+id/tab3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Data"
                    android:textColor="#555555"
                    android:textSize="10sp"
                    android:gravity="center"/>

                <TextView
                    android:id="@+id/tab4"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Horario"
                    android:textColor="#555555"
                    android:textSize="10sp"
                    android:gravity="center"/>

                <TextView
                    android:id="@+id/tab5"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Confirmacao"
                    android:textColor="#555555"
                    android:textSize="10sp"
                    android:gravity="center"/>

            </LinearLayout>

            <!-- LINHA DE PROGRESSO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <View
                    android:id="@+id/progress1"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="#C8102E"/>

                <View
                    android:id="@+id/progress2"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="#333333"/>

                <View
                    android:id="@+id/progress3"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="#333333"/>

                <View
                    android:id="@+id/progress4"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="#333333"/>

                <View
                    android:id="@+id/progress5"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="#333333"/>

            </LinearLayout>

        </LinearLayout>

        <!-- CONTEÚDO -->
        <FrameLayout
            android:id="@+id/frameConteudo"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <!-- BOTÕES -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:background="#1a1a1a"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/btnVoltarPasso"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="Voltar"
                android:textColor="#F5F5F0"
                android:backgroundTint="#2A2A2A"
                android:stateListAnimator="@null"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/btnContinuar"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="Continuar"
                android:textColor="#F5F5F0"
                android:backgroundTint="#C8102E"
                android:stateListAnimator="@null"/>

        </LinearLayout>

    </LinearLayout>
</layout>