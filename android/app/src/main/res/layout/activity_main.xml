<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="viewModel"
            type="com.example.na_navalha.viewmodel.AgendamentoViewModel" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#111111">

        <!-- HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1a1a1a"
            android:padding="16dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NaNavalha"
                android:textColor="#F5F5F0"
                android:textSize="24sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BARBERSHOP"
                android:textColor="#C8102E"
                android:textSize="12sp"
                android:letterSpacing="0.3"/>
        </LinearLayout>

        <!-- BARRA VERMELHA -->
        <View
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:background="#C8102E"/>

        <!-- FORMULÁRIO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="#1a1a1a"
            android:layout_margin="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NOVO AGENDAMENTO"
                android:textColor="#F5F5F0"
                android:textSize="14sp"
                android:letterSpacing="0.2"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ID DO CLIENTE"
                android:textColor="#A09890"
                android:textSize="11sp"
                android:letterSpacing="0.1"/>

            <EditText
                android:id="@+id/etClienteId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:hint="Ex: 1"
                android:textColor="#F5F5F0"
                android:textColorHint="#555555"
                android:background="#222222"
                android:padding="10dp"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ID DO BARBEIRO"
                android:textColor="#A09890"
                android:textSize="11sp"
                android:letterSpacing="0.1"/>

            <EditText
                android:id="@+id/etBarbeiroId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:hint="Ex: 1"
                android:textColor="#F5F5F0"
                android:textColorHint="#555555"
                android:background="#222222"
                android:padding="10dp"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ID DO SERVIÇO"
                android:textColor="#A09890"
                android:textSize="11sp"
                android:letterSpacing="0.1"/>

            <EditText
                android:id="@+id/etServicoId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:hint="Ex: 1"
                android:textColor="#F5F5F0"
                android:textColorHint="#555555"
                android:background="#222222"
                android:padding="10dp"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DATA E HORA"
                android:textColor="#A09890"
                android:textSize="11sp"
                android:letterSpacing="0.1"/>

            <EditText
                android:id="@+id/etDataHora"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Ex: 2024-06-01 10:00:00"
                android:textColor="#F5F5F0"
                android:textColorHint="#555555"
                android:background="#222222"
                android:padding="10dp"
                android:layout_marginBottom="16dp"/>

            <Button
                android:id="@+id/btnSalvar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SALVAR AGENDAMENTO"
                android:backgroundTint="#C8102E"
                android:textColor="#FFFFFF"
                android:letterSpacing="0.1"/>
        </LinearLayout>

        <!-- LISTA -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AGENDAMENTOS"
            android:textColor="#A09890"
            android:textSize="11sp"
            android:letterSpacing="0.2"
            android:paddingStart="16dp"
            android:paddingBottom="8dp"/>

        <ListView
            android:id="@+id/listViewAgendamentos"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:divider="#222222"
            android:dividerHeight="1dp"/>

    </LinearLayout>
</layout>